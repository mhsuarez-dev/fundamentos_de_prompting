rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Health check document for validating connection
    match /test/connection {
      allow get: if true;
    }

    // Isolated user simulation progress
    match /users/{userId}/progress/simulation {
      allow get, write: if isOwner(userId) && isValidId(userId);
      allow list: if false;
    }
  }
}
